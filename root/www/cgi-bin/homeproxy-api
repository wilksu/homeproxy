/* Same-origin gRPC-Web relay. Each stream has a finite lifetime; the browser
 * reconnects and reauthenticates. The sing-box secret never leaves the router. */
import { stdin, stdout, readfile, writefile, mkdtemp, chmod, unlink, rmdir, popen, mkdir, lsdir, open, stat } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';

function fail(status, message) {
	print('Status: ' + status + '\r\nContent-Type: text/plain\r\nCache-Control: no-store\r\n\r\n' + message);
	exit(0);
}
function quote(s) { return "'" + replace(s, "'", "'\\''") + "'"; }
const readMethods = ['GetVersion', 'SubscribeServiceStatus', 'SubscribeLog', 'GetDefaultLogLevel',
	'SubscribeStatus', 'SubscribeGroups', 'GetClashModeStatus', 'SubscribeClashMode',
	'SubscribeConnections', 'GetDeprecatedWarnings', 'GetStartedAt', 'SubscribeOutbounds', 'SubscribeTailscaleStatus'];
const writeMethods = ['URLTest', 'SelectOutbound', 'SetGroupExpand', 'SetClashMode',
	'CloseConnection', 'CloseAllConnections', 'ClearLogs', 'StartSTUNTest', 'StartNetworkQualityTest', 'StartTailscalePing'];
const path = match(getenv('PATH_INFO') || '', /^\/(client|server)\/([A-Za-z]+)$/);
if (!path || !(path[2] in [...readMethods, ...writeMethods])) fail('404 Not Found', 'Unknown API method');
if (getenv('REQUEST_METHOD') !== 'POST') fail('405 Method Not Allowed', 'POST required');
if (index(getenv('CONTENT_TYPE') || '', 'application/grpc-web+proto') !== 0)
	fail('415 Unsupported Media Type', 'gRPC-Web protobuf required');
const origin = getenv('HTTP_ORIGIN');
if (origin && replace(origin, /^https?:\/\//, '') !== getenv('HTTP_HOST'))
	fail('403 Forbidden', 'Cross-origin request rejected');
const cookies = getenv('HTTP_COOKIE') || '';
const cookieToken = match(cookies, /(^|;[[:space:]]*)sysauth(_https|_http)?=([a-f0-9]{32})(;|$)/)?.[3];
/* LuCI cookies are scoped to /cgi-bin/luci/, outside this CGI path. */
const headerToken = match(getenv('HTTP_AUTHORIZATION') || '', /^LuCI ([a-f0-9]{32})$/)?.[1];
const token = headerToken || cookieToken;
if (!match(token || '', /^[a-f0-9]{32}$/)) fail('401 Unauthorized', 'LuCI login required');
const ubus = connect();
const permission = path[2] in writeMethods ? 'api_control' : 'api_read';
if (!ubus.call('session', 'access', { ubus_rpc_session: token, scope: 'ubus', object: 'luci.homeproxy', function: permission })?.access)
	fail('403 Forbidden', 'Insufficient HomeProxy permissions');
const jobs = '/tmp/homeproxy-api-streams';
mkdir(jobs, 0700);
const size = int(getenv('CONTENT_LENGTH'));
if (size < 5 || size > 32768) fail('413 Payload Too Large', 'Invalid request size');
let body = stdin.read(size);
if (length(body) !== size) fail('400 Bad Request', 'Incomplete request');
if (path[2] in ['SubscribeStatus', 'SubscribeConnections'])
 body = chr(0, 0, 0, 0, 6, 8, 128, 148, 235, 220, 3);
let config;
try { config = json(readfile('/var/run/homeproxy/sing-box-' + (path[1] === 'client' ? 'c' : 's') + '.json')); }
catch (e) { fail('503 Service Unavailable', 'No running configuration'); }
const api = filter(config?.services || [], (s) => s.type === 'api')[0];
if (!api || !match(api.secret || '', /^[a-f0-9]{64}$/)) fail('503 Service Unavailable', 'API is disabled');
let host = api.listen;
if (host === '0.0.0.0' || host === '::') host = '127.0.0.1';
if (index(host, ':') >= 0) host = '[' + host + ']';
/* Serialize admission without holding any lock during a network request. */
const lock = jobs + '/admission';
if (!mkdir(lock, 0700)) {
 if (time() - (stat(lock)?.mtime || time()) > 5) rmdir(lock);
 fail('503 Service Unavailable', 'API admission busy; retry');
}
const persistent = path[2] in ['SubscribeLog', 'SubscribeConnections', 'StartSTUNTest', 'StartNetworkQualityTest', 'StartTailscalePing'];
let count = 0, owned = 0;
for (let entry in lsdir(jobs) || []) {
 if (index(entry, 'job.') !== 0) continue;
 const stale = jobs + '/' + entry;
 if (time() - (stat(stale)?.mtime || time()) > 90) {
  for (let file in lsdir(stale) || []) unlink(stale + '/' + file);
  rmdir(stale); continue;
 }
 try { const owner = json(readfile(jobs + '/' + entry + '/owner')); if (owner.persistent) { count++; if (owner.session === token) owned++; } } catch (e) {}
}
if (persistent && (count >= 2 || owned >= 1)) { rmdir(lock); fail('429 Too Many Requests', 'Too many API jobs; close the other HomeProxy stream and refresh'); }
const dir = mkdtemp(jobs + '/job.XXXXXX');
if (!dir) { rmdir(lock); fail('503 Service Unavailable', 'Unable to allocate request'); }
chmod(dir, 0700);
/* Publish ownership before releasing admission, so concurrent requests count it. */
if (!writefile(dir + '/owner', sprintf('%J', { session: token, instance: path[1], method: path[2], persistent }))) {
 unlink(dir + '/owner'); rmdir(dir); rmdir(lock);
 fail('503 Service Unavailable', 'Unable to initialize request');
}
rmdir(lock);
writefile(dir + '/lease', '' + time());
writefile(dir + '/body', body);
const serverName = api.tls?.enabled ? cursor().get('homeproxy', 'observability', 'tls_server_name') : null;
if (serverName && !match(serverName, /^[A-Za-z0-9][A-Za-z0-9.-]*$/)) fail('503 Service Unavailable', 'Invalid TLS server name');
const url = (api.tls?.enabled ? 'https://' : 'http://') + (serverName || host) + ':' + api.listen_port + '/daemon.StartedService/' + path[2];
let request = 'silent\nshow-error\nno-buffer\nnoproxy = "*"\nconnect-timeout = 3\nmax-time = ' + (persistent ? '45' : '5') + '\n' +
 'header = "Authorization: Bearer ' + api.secret + '"\nheader = "Content-Type: application/grpc-web+proto"\n' +
 'data-binary = "@' + dir + '/body"\nurl = "' + url + '"\n';
if (serverName) request += 'resolve = "' + serverName + ':' + api.listen_port + ':' + host + '"\n';
if (api.tls?.enabled) {
 const pem = type(api.tls.certificate) === 'array' ? join('\n', api.tls.certificate) : api.tls.certificate;
 const certificate = pem || readfile(api.tls.certificate_path);
 if (!certificate) { for (let file in lsdir(dir) || []) unlink(dir + '/' + file); rmdir(dir); fail('503 Service Unavailable', 'API TLS certificate missing'); }
 writefile(dir + '/ca', certificate);
 request += 'cacert = "' + dir + '/ca"\n';
}
writefile(dir + '/request', request);
/* Stream directly to the browser: no data file or offset polling. */
print('Content-Type: application/grpc-web+proto\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n');
stdout.flush();
const parent = split(readfile('/proc/self/stat'), ' ')[0];
system(['/bin/sh', '/etc/homeproxy/scripts/api-stream.sh', dir, parent]);
